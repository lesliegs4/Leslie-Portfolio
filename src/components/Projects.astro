---
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="projects">
  <div class="projects-heading">
    <p class="section-number">02</p>

    <h2>Projects</h2>

    <p class="projects-note">
      things I've built, broken, fixed, and learned from
    </p>
  </div>

  <div class="projects-list">
    <ProjectCard
      title="TriageLens"
      year="2026"
      type="iOS / Emergency Response"
      description="An iOS app built at USC AthenaHacks that uses camera-based vital sign estimation to help first responders assess patients more quickly during high-pressure emergencies."
      video="/images/projects/triagelens-demo.mp4"
      award="Best Overall + Best Hack by Bloomberg Engineering"
    />

    <ProjectCard
      title="LoRa Sensor Network"
      year="2025"
      type="IoT / Embedded Systems / Research"
      description="A long-range, low-power IoT sensor network built during my research internship at RWTH Aachen University for off-grid environmental monitoring using LoRa, Raspberry Pi Pico, and secure Meshtastic communication."
      image="/images/projects/lora-project.jpeg"
    />
  </div>
</section>

<style>
  .projects-heading {
    margin-bottom: 4rem;
  }

  .section-number {
    margin: 0 0 0.5rem;

    font-size: 0.75rem;
    letter-spacing: 0.15em;

    color: var(--gray);
  }

  h2 {
    margin: 0;

    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.9;
  }

  .projects-note {
    margin: 1rem 0 0 3rem;

    max-width: 400px;

    font-size: 1rem;
    font-style: italic;

    transform: rotate(-2deg);
  }

  .projects-list {
    display: grid;
    gap: 4rem;
  }

  .projects-list :global(.project-card:nth-child(even)) {
    transform: rotate(0.5deg);
  }

  .projects-list :global(.project-card:nth-child(odd)) {
    transform: rotate(-0.5deg);
  }
</style>