---
import Doodle from "./Doodle.astro";
import { withBase } from "../utils/withBase";
import { getSitePhotos } from "../utils/sitePhotos";

const frames = getSitePhotos();
const carouselFrames = [...frames, ...frames];

const mediumUrl = "https://lesliegs.medium.com/";
---

<section id="writing" class="writing">
  <div class="section-head">
    <p class="section-number"><span>05</span> The Back Pages</p>

    <div class="writing-title">
      <h2>Writing<br />+ Photos</h2>

      <p class="lede writing-lede">
        A collection of writing, photography, travel notes, and things I want to
        remember.
        <a
          class="writing-medium-inline"
          href={mediumUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read my essays on Medium
        </a>
      </p>
    </div>
  </div>

  <!-- CONTACT SHEET CAROUSEL -->
  <figure class="contact-sheet tilt-r-sm">
    <div class="sheet-head">
      <p class="sheet-title">Contact Sheet &mdash; Roll 01</p>
      <p class="sheet-meta">
        ISO 400 &middot;
        <button
          type="button"
          class="sheet-tone-toggle"
          data-tone-toggle
          aria-pressed="false"
        >
          B&amp;W
        </button>
        &middot; Ongoing
      </p>
    </div>

    <div class="sprockets" aria-hidden="true"></div>

    <div class="carousel" aria-label="Photo contact sheet carousel">
      <div class="carousel-track">
        {
          carouselFrames.map(({ src, alt }, i) => (
            <div class="frame" aria-hidden={i >= frames.length ? "true" : undefined}>
              <img class="photo" src={withBase(src)} alt={alt} loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>

    <div class="sprockets" aria-hidden="true"></div>
  </figure>

  <!-- MEDIUM -->
  <div class="writing-index">
    <a
      class="writing-medium-card"
      href={mediumUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <p class="hand writing-note">
        essays + notes on Medium
        <Doodle type="arrow-right" width="52px" color="var(--gray-light)" />
      </p>

      <p class="writing-medium-url">lesliegs.medium.com</p>

      <p class="caption writing-medium-detail">
        Travel notes, build logs, and longer-form writing live there.
      </p>
    </a>
  </div>
</section>

<script>
  document.querySelectorAll("[data-tone-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const sheet = button.closest(".contact-sheet");
      if (!sheet) return;

      const isColor = sheet.classList.toggle("is-color");
      button.setAttribute("aria-pressed", String(isColor));
      button.textContent = isColor ? "Color" : "B&W";
    });
  });
</script>

<style>
  .writing-title {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }

  .writing-lede {
    max-width: 34ch;
    margin: 0 0 0.5rem;
  }

  .writing-medium-inline {
    display: block;
    margin-top: 0.85rem;

    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--pink-deep);

    border-bottom: 1px solid transparent;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .writing-medium-inline:hover {
    color: var(--ink);
    border-bottom-color: var(--pink);
  }

  /* ---- contact sheet ---- */

  .contact-sheet {
    margin: 0;
    padding: 1.5rem clamp(1rem, 2.5vw, 1.75rem);

    background: #1c1a17;
    box-shadow: 0 14px 32px rgba(20, 17, 15, 0.25);
  }

  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;

    margin-bottom: 1rem;
  }

  .sheet-head p {
    margin: 0;
  }

  .sheet-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--pink);
  }

  .sheet-meta {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 240, 230, 0.55);
  }

  .sheet-tone-toggle {
    font: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;

    padding: 0;
    margin: 0;

    background: none;
    border: none;
    cursor: pointer;
  }

  /* Film sprocket holes above and below the frame row */
  .sprockets {
    height: 11px;
    background: repeating-linear-gradient(
      90deg,
      rgba(245, 240, 230, 0.82) 0 9px,
      transparent 9px 24px
    );
  }

  .carousel {
    overflow: hidden;
    padding: clamp(0.6rem, 1.5vw, 1rem) 0;
  }

  .carousel-track {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.65rem, 1.5vw, 1.1rem);
    width: max-content;

    animation: carousel-scroll 120s linear infinite;
  }

  .carousel:hover .carousel-track {
    animation-play-state: paused;
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .frame {
    flex: 0 0 auto;
    width: max-content;
    max-width: min(42vw, 320px);
  }

  .frame img {
    display: block;
    width: auto;
    height: clamp(9rem, 24vw, 15.5rem);
    max-width: 100%;
    object-fit: contain;

    /* Pushed contrast so the frames read as a photographic proof print */
    filter: grayscale(1) contrast(1.3) brightness(0.95);
    transition: filter 0.5s ease;
  }

  .contact-sheet.is-color .frame img {
    filter: grayscale(0) contrast(1.05) brightness(1);
  }

  /* ---- medium link ---- */

  .writing-index {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .writing-medium-card {
    display: block;
    max-width: 34rem;
    padding: 1.5rem 1.25rem 1.75rem;
    text-decoration: none;
    color: inherit;

    border-top: 2px solid var(--rule);
    border-bottom: 1px solid var(--hairline);
    transition: background 0.25s ease;
  }

  .writing-medium-card:hover {
    background: var(--blush);
  }

  .writing-note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    margin: 0 0 0.75rem;
    transform: rotate(-1.5deg);
  }

  .writing-medium-url {
    margin: 0 0 0.5rem;

    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-style: italic;
    color: var(--ink);
  }

  .writing-medium-detail {
    margin: 0;
  }

  @media (max-width: 860px) {
    .writing-title {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }

    .frame[aria-hidden="true"] {
      display: none;
    }
  }
</style>
