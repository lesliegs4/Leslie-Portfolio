---
import Doodle from "./Doodle.astro";
import Tape from "./Tape.astro";
import { withBase } from "../utils/withBase";

interface Props {
  index: string;
  title: string;
  year: string;
  type: string;
  description: string;
  image?: string;
  video?: string;
  award?: string;
  note?: string;
  /** Mirrors the layout so consecutive cards alternate across the spread */
  flip?: boolean;
}

const {
  index,
  title,
  year,
  type,
  description,
  image,
  video,
  award,
  note,
  flip = false,
} = Astro.props;
---

<article
  class={`project-card ${flip ? "is-flipped" : ""} ${video ? "has-video" : ""}`}
>
  <div class="project-media">
    <div class="print media-frame">
      <Tape
        tone={flip ? "pink" : "beige"}
        width="126px"
        rotate={flip ? 9 : -9}
        class="media-tape"
      />

      {
        image && (
          <img
            class="photo"
            src={withBase(image)}
            alt={`${title} project`}
            loading="lazy"
          />
        )
      }

      {
        video && (
          <video class="photo" controls muted playsinline preload="metadata">
            <source src={withBase(video)} type="video/mp4" />
            Your browser does not support video playback.
          </video>
        )
      }
    </div>

    <p class="caption media-caption">
      <span class="label">Fig. {index}</span>
      {title}, {year}
    </p>
  </div>

  <div class="project-content">
    <div class="project-meta">
      <span class="label">{year}</span>
      <span class="meta-divider" aria-hidden="true">/</span>
      <span class="label">{type}</span>
    </div>

    <h3>{title}</h3>

    {
      award && (
        <p class="award">
          <Doodle type="sparkle" width="16px" color="var(--pink-deep)" />
          {award}
        </p>
      )
    }

    <p class="description">{description}</p>

    {
      note && (
        <p class="hand project-note">
          <Doodle type="arrow-right" width="42px" color="var(--gray-light)" />
          {note}
        </p>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;

    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  /* Alternating spread: media swaps sides on every other card */
  .project-card.is-flipped .project-media {
    order: 2;
  }

  /* ---- media ---- */

  .media-frame {
    position: relative;
  }

  .media-frame :global(.media-tape) {
    position: absolute;
    top: -14px;
    left: 50%;
    margin-left: -63px;
    z-index: 2;
  }

  .media-frame img,
  .media-frame video {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;

    background: var(--paper-deep);
  }

  /* Screen recordings are portrait, so the frame follows the source
     shape and shows the whole app instead of cropping it to 4:3 */
  .has-video .project-media {
    max-width: 340px;
    margin-inline: auto;
  }

  .media-frame video {
    aspect-ratio: 1170 / 2532;
    object-fit: contain;

    /* Video controls shouldn't be desaturated along with the frame */
    filter: grayscale(0.85) contrast(1.08);
  }

  .media-frame video:hover {
    filter: grayscale(0) contrast(1);
  }

  .media-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    margin: 0.85rem 0 0;
    padding-top: 0.45rem;

    font-style: italic;
    border-top: 1px solid var(--hairline);
  }

  .media-caption .label {
    font-style: normal;
    color: var(--pink-deep);
  }

  /* ---- content ---- */

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;

    margin-bottom: 1rem;
    padding-bottom: 0.7rem;

    border-bottom: 1px solid var(--hairline);
  }

  .meta-divider {
    font-size: 0.7rem;
    color: var(--gray-light);
  }

  .project-content h3 {
    font-style: italic;
  }

  /* Award reads like a rubber stamp taped to the page */
  .award {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    width: fit-content;
    margin: 1.25rem 0 0;
    padding: 0.5rem 0.85rem;

    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink);

    background: var(--blush);
    border: 1px solid var(--blush-warm);
    transform: rotate(-1.5deg);
  }

  .description {
    max-width: 46ch;
    margin: 1.5rem 0 0;
    font-size: 0.98rem;
  }

  .project-note {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    margin: 1.5rem 0 0;
    transform: rotate(-1deg);
  }

  @media (max-width: 860px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    /* Keep the image above the copy regardless of the flip */
    .project-card.is-flipped .project-media {
      order: 0;
    }

    .description {
      max-width: none;
    }
  }
</style>
