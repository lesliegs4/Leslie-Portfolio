---
import Doodle from "./Doodle.astro";
import Tape from "./Tape.astro";

// Magazine-style cover lines teasing what's further down the page
const coverLines = [
  { number: "01", text: "Learn a little about who I am" },
  { number: "02", text: "Notes from four internships and one design lab" },
  { number: "03", text: "Telling stories: photos and prose" },
];
---

<section id="home" class="hero">
  <div class="hero-grid">
    <div class="hero-main">
      <p class="label hero-kicker">
        Issue 01 &middot; Engineering, Security &amp; Side Quests
      </p>

      <h1 class="hero-title">
        <span class="hero-first">Leslie</span>
        <span class="hero-last">Garcia&#8209;Sanchez</span>
      </h1>

      <div class="hero-underline">
        <Doodle type="underline" width="clamp(180px, 34vw, 420px)" stroke={2} />
      </div>

      <p class="lede hero-lede">
        Computer engineer, cybersecurity student, researcher, builder, and
        <span class="marker">collector of side quests</span>.
      </p>

      <a class="hero-link" href="#about">
        <span>More about me</span>
        <Doodle type="arrow-down" width="26px" stroke={2} />
      </a>
    </div>

    <aside class="hero-side">
      <div class="hero-note note tilt-r">
        <Tape tone="pink" width="108px" rotate={-7} class="hero-note-tape" />

        <p class="label">Currently</p>
        <p class="hand hand-ink hero-note-text">
          building things + figuring it out along the way
        </p>
      </div>

      <div class="hero-contents">
        <p class="label hero-contents-head">In this issue</p>

        <ul>
          {
            coverLines.map(({ number, text }) => (
              <li>
                <span class="hero-contents-number">{number}</span>
                <span class="hero-contents-text">{text}</span>
              </li>
            ))
          }
        </ul>

        <Doodle
          type="arrow-curve"
          width="76px"
          class="hero-contents-arrow"
          color="var(--gray-light)"
        />
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: min(88vh, 900px);
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.75fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  /* ---- masthead type ---- */

  .hero-kicker {
    margin: 0 0 1.75rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
  }

  .hero-first {
    font-weight: 500;
  }

  /* The surname carries the fashion-magazine italic */
  .hero-last {
    margin-left: clamp(0.5rem, 4vw, 3.5rem);

    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.045em;
  }

  .hero-underline {
    margin: 0.4rem 0 0 clamp(0.5rem, 4vw, 3.5rem);
    color: var(--pink);
  }

  .hero-lede {
    max-width: 40ch;
    margin: 2.25rem 0 0;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    margin-top: 2.5rem;
    padding-bottom: 0.3rem;

    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-decoration: none;
    color: var(--ink);

    border-bottom: 1px solid var(--ink);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .hero-link :global(.doodle) {
    transition: transform 0.3s ease;
  }

  .hero-link:hover {
    color: var(--pink-deep);
    border-bottom-color: var(--pink);
  }

  .hero-link:hover :global(.doodle) {
    transform: translateY(3px);
  }

  /* ---- taped note ---- */

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;

    padding-top: 1.5rem;
  }

  .hero-note {
    max-width: 250px;
  }

  .hero-note :global(.hero-note-tape) {
    position: absolute;
    top: -13px;
    left: 50%;
    margin-left: -54px;
  }

  .hero-note p.label {
    margin: 0 0 0.35rem;
    color: var(--pink-deep);
  }

  .hero-note-text {
    margin: 0;
    font-size: 1.4rem;
  }

  /* ---- cover lines / contents ---- */

  .hero-contents {
    position: relative;
    max-width: 270px;
  }

  .hero-contents-head {
    margin: 0 0 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--rule);
  }

  .hero-contents ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-contents li {
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    gap: 0.4rem;

    padding: 0.6rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-contents-number {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.9;
    color: var(--pink-deep);
  }

  .hero-contents-text {
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .hero-contents :global(.hero-contents-arrow) {
    position: absolute;
    right: -12px;
    bottom: -66px;
    transform: rotate(-155deg);
  }

  /* ---- footer line of the cover ---- */

  .hero-folio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;

    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding-top: 0.9rem;

    font-style: italic;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-side {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2.5rem;

      padding-top: 0;
    }

    .hero-contents :global(.hero-contents-arrow) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-last {
      margin-left: 0;
    }

    .hero-underline {
      margin-left: 0;
    }
  }
</style>
