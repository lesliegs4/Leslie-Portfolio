---
import Doodle from "./Doodle.astro";

const year = new Date().getFullYear();
---

<footer class="colophon">
  <div class="colophon-grid">
    <div class="colophon-main">
      <p class="label">Colophon</p>

      <p class="colophon-line">
        Made by <em>Leslie Garcia&#8209;Sanchez</em>.
      </p>

      <p class="hand colophon-note">
        thanks for reading all the way down here
        <Doodle type="sparkle" width="18px" />
      </p>
    </div>

    <dl class="colophon-meta">
      <div>
        <dt class="label">Set in</dt>
        <dd>Bodoni Moda, Archivo &amp; Caveat</dd>
      </div>
      <div>
        <dt class="label">Built with</dt>
        <dd>Astro, by me</dd>
      </div>
      <div>
        <dt class="label">Edition</dt>
        <dd>Vol. 01 &middot; {year}</dd>
      </div>
    </dl>
  </div>

  <a class="to-top" href="#home">
    <Doodle type="arrow-down" width="20px" class="to-top-arrow" />
    <span>Back to the cover</span>
  </a>
</footer>

<style>
  .colophon-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .colophon-main p.label {
    margin: 0 0 0.9rem;
  }

  .colophon-line {
    margin: 0;

    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .colophon-line em {
    font-style: italic;
  }

  .colophon-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    margin: 1.25rem 0 0;
    transform: rotate(-1.5deg);
  }

  /* ---- printer's details ---- */

  .colophon-meta {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }

  .colophon-meta > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;

    padding: 0.7rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .colophon-meta dt {
    margin: 0;
  }

  .colophon-meta dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink);
  }

  /* ---- back to top ---- */

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    margin-top: clamp(2.5rem, 5vw, 4rem);

    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-decoration: none;
    color: var(--ink);
  }

  .to-top :global(.to-top-arrow) {
    transform: rotate(180deg);
    transition: transform 0.3s ease;
  }

  .to-top:hover {
    color: var(--pink-deep);
  }

  .to-top:hover :global(.to-top-arrow) {
    transform: rotate(180deg) translateY(4px);
  }

  @media (max-width: 760px) {
    .colophon-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
